import ast
from pathlib import Path
import subprocess

root = Path.cwd()
base = '0106f1a0e0dfbcbf18e9732f4924b8ccd9e937f0'
expected = {
    'scripts/claix_b24_launch.py',
    'xr1/mibot/utils/claix_checkpoint.py',
    'xr1/mibot/utils/claix_experiment.py',
    'xr1/mibot/utils/claix_runtime.py',
    'xr1/tools/train_doosan_compact.py',
    'xr1/tests/run_claix_experimental_cpu_tests.py',
    'xr1/tests/test_claix_experimental.py',
    'xr1/tests/test_claix_runtime.py',
}
def git(*args):
    return subprocess.check_output(['git', *args], cwd=root)
assert git('rev-parse', 'HEAD').decode().strip() == base
assert git('branch', '--show-current').decode().strip() == 'thesis/xr1-checkpoint500-v1'
assert set(git('diff', '--name-only', base).decode().splitlines()) == expected
print('START_COMMIT_BRANCH_AND_TRACKED_CHANGE_SCOPE=PASS')
python_files = sorted([*expected, 'xr1/tests/test_claix_checkpoint500.py'])
for name in python_files:
    ast.parse((root/name).read_text(), filename=name)
print(f'PYTHON_AST=PASS files={len(python_files)}')
wrappers = sorted(root.glob('scripts/claix_b24*.sbatch'))
for path in [*wrappers, root/'scripts/claix_b24_environment.sh']:
    subprocess.run(['bash', '-n', str(path)], check=True)
print(f'BASH_SYNTAX=PASS wrappers={len(wrappers)} environment_scripts=1')
tracked = git('ls-files').decode().splitlines()
protected = [name for name in tracked if (
    name.startswith(('xr1/configs/', 'xr1/mibot/models/', 'xr1/mibot/data/',
                     'xr1/mibot/utils/doosan_'))
    or name in {'xr1/mibot/utils/claix_contract.py', 'xr1/mibot/utils/claix_resume_bridge.py',
                'xr1/mibot/utils/claix_evaluation.py', 'xr1/mibot/utils/cosine_warmup.py',
                'xr1/tools/train.py'}
    or name.startswith('scripts/claix_b24') and name != 'scripts/claix_b24_launch.py')]
for name in protected:
    assert (root/name).read_bytes() == git('show', base+':'+name), name
print(f'BASELINE_PROTECTED_BYTES=PASS files={len(protected)}')
for name in protected:
    print('UNCHANGED '+name)
subprocess.run(['git', 'diff', '--check'], check=True)
print('GIT_DIFF_CHECK=PASS')
print('GPU_JOBS=0; no Slurm commands or GPU queries executed by these checks')

